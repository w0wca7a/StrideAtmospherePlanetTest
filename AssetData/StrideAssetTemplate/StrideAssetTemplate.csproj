<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Rename these (and the folder + .csproj file) to your asset's name. -->
    <RootNamespace>StrideAssetTemplate</RootNamespace>
    <AssemblyName>StrideAssetTemplate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep dependencies minimal: this project is compiled inside your users' games. -->
    <PackageReference Include="Stride.Engine" Version="4.4.0-beta5" />
    <!-- Builds the .sdpkg next to this file, so the asset can ship Stride content and not just code. -->
    <PackageReference Include="Stride.AssetCompiler" Version="4.4.0-beta5" IncludeAssets="build;buildTransitive" />
  </ItemGroup>

</Project>
